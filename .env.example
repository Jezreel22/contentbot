# Set variables in secure environment settings; no secrets are included here.
# The Python application does not automatically load this file.
# Optional shell values: pass these explicitly to uvicorn --host and --port.
HOST=127.0.0.1
PORT=3000
# Required before exposing this dashboard beyond localhost.
APP_PASSWORD=
# Optional: real AI generation. Without it, clearly labeled templates are used.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Default workspace only. Requires official platform API permissions.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
X_ACCESS_TOKEN=
# WhatsApp Cloud API approvals (requires approved Meta template and public HTTPS webhook)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Optional alternative Telegram channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVER_ID=
